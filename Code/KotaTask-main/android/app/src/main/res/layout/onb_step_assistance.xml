<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Kt.Text.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onb_assistance_title"/>

        <TextView
            style="@style/Kt.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:text="@string/onb_assistance_subtitle"/>

        <RadioGroup
            android:id="@+id/onbRgAssistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/onbRbAsstMinimal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:textStyle="bold"
                android:text="@string/onb_assistance_minimal"/>
            <TextView style="@style/Kt.Text.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginBottom="8dp"
                android:textColor="@color/text_secondary"
                android:text="@string/onb_assistance_minimal_desc"/>

            <RadioButton
                android:id="@+id/onbRbAsstStandard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:textStyle="bold"
                android:text="@string/onb_assistance_standard"/>
            <TextView style="@style/Kt.Text.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginBottom="8dp"
                android:textColor="@color/text_secondary"
                android:text="@string/onb_assistance_standard_desc"/>

            <RadioButton
                android:id="@+id/onbRbAsstAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:textStyle="bold"
                android:text="@string/onb_assistance_advanced"/>
            <TextView style="@style/Kt.Text.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginBottom="8dp"
                android:textColor="@color/text_secondary"
                android:text="@string/onb_assistance_advanced_desc"/>

            <RadioButton
                android:id="@+id/onbRbAsstCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:textStyle="bold"
                android:text="@string/onb_assistance_custom"/>
            <TextView style="@style/Kt.Text.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:textColor="@color/text_secondary"
                android:text="@string/onb_assistance_custom_desc"/>
        </RadioGroup>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
