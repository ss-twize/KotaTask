<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="@color/border_subtle"
    app:cardBackgroundColor="@color/bg_surface"
    app:rippleColor="@color/bg_surface_alt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- ═══ Importance accent stripe ═══ -->
        <View
            android:id="@+id/stripeImportance"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@drawable/stripe_low"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <!-- ═══ Title row ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/Kt.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <!-- Score badge -->
                <LinearLayout
                    android:id="@+id/scoreBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="-2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="9dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/bg_chip_score"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/score_text"/>

                    <TextView
                        android:id="@+id/tvScoreChip"
                        style="@style/Kt.Text.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/score_text"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNeedsDetails"
                style="@style/Kt.Text.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_chip_yellow"
                android:text="✎ Дополнить задачу"
                android:textColor="@color/text_primary"
                android:visibility="gone" />

            <!-- ═══ Context (location) — 2nd most prominent after title ═══ -->
            <LinearLayout
                android:id="@+id/contextRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/primary"/>

                <TextView
                    android:id="@+id/tvContext"
                    style="@style/Kt.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- ═══ Importance + Deadline + Duration chips ═══ -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/chipsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:flexWrap="wrap"
                app:alignItems="center">

                <!-- Importance pill -->
                <LinearLayout
                    android:id="@+id/importancePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/bg_chip_gray">

                    <View
                        android:id="@+id/dotImportance"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/circle_green"/>

                    <TextView
                        android:id="@+id/tvImportance"
                        style="@style/Kt.Text.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>

                <!-- Deadline chip -->
                <TextView
                    android:id="@+id/tvDeadlineChip"
                    style="@style/Kt.Text.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="11sp"
                    android:textColor="@color/deadline_future"
                    android:background="@drawable/bg_chip"
                    android:visibility="gone"/>

                <!-- Duration chip -->
                <TextView
                    android:id="@+id/tvDurationChip"
                    style="@style/Kt.Text.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_chip_gray"/>

            </com.google.android.flexbox.FlexboxLayout>

            <!-- ═══ Parent project ═══ -->
            <LinearLayout
                android:id="@+id/parentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_folder"
                    app:tint="@color/text_tertiary"/>

                <TextView
                    android:id="@+id/tvParent"
                    style="@style/Kt.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- ═══ Completed timestamp (archive) ═══ -->
            <LinearLayout
                android:id="@+id/completedRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/success"/>

                <TextView
                    android:id="@+id/tvCompleted"
                    style="@style/Kt.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <!-- Hidden legacy importance badge (kept for adapter compat) -->
            <TextView
                android:id="@+id/tvImportanceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/bg_badge_red"/>

            <!-- ═══ Actions ═══ -->
            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction1"
                    style="@style/Widget.KotaTask.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:cornerRadius="12dp"
                    android:text="@string/action_complete"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction2"
                    style="@style/Widget.KotaTask.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:cornerRadius="12dp"
                    android:text="@string/action_to_stack"/>

                <!-- Третья кнопка «Отложить» — видна только в стеке при включённом
                     отложенном планировании (управляется адаптером). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction3"
                    style="@style/Widget.KotaTask.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:cornerRadius="12dp"
                    android:text="@string/action_defer"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="18dp"
            android:buttonTint="@color/primary"
            android:visibility="gone"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
