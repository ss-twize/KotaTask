<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetQuickAdd"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_widget_quick_add"
    android:contentDescription="@string/widget_quick_add_description">
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_widget_add"
        android:importantForAccessibility="no" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="@string/widget_quick_add_hint"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/app_name"
        android:textSize="11sp"
        android:textColor="@color/text_secondary" />
</LinearLayout>
