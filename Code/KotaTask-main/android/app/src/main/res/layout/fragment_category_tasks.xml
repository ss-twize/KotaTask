<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_canvas"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/tvCategoryHeader"
        style="@style/Kt.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategoryTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"/>

    <TextView
        android:id="@+id/tvCategoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:text="@string/folders_empty"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddTaskInCategory"
        style="@style/Widget.KotaTask.Button.Hero"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="@string/btn_add_task"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/hero_button_icon"
        app:iconPadding="8dp"/>

</LinearLayout>
