<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <!-- Top: step counter + linear progress bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/onbStepLabel"
                style="@style/Kt.Text.Overline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onbBtnSkip"
                style="@style/Widget.KotaTask.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onb_skip"
                android:visibility="gone"/>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/onbProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:trackCornerRadius="3dp"
            app:trackThickness="4dp"
            android:max="100"/>
    </LinearLayout>

    <!-- Middle: step content -->
    <ViewFlipper
        android:id="@+id/onbFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include android:id="@+id/stepWelcome"    layout="@layout/onb_step_welcome"/>
        <include android:id="@+id/stepSystem"     layout="@layout/onb_step_system"/>
        <include android:id="@+id/stepFeatures"   layout="@layout/onb_step_features"/>
        <include android:id="@+id/stepCoeffs"     layout="@layout/onb_step_coeffs"/>
        <include android:id="@+id/stepCalendar"   layout="@layout/onb_step_calendar"/>
        <include android:id="@+id/stepAssistance" layout="@layout/onb_step_assistance"/>
        <include android:id="@+id/stepFields"     layout="@layout/onb_step_fields"/>
    </ViewFlipper>

    <!-- Bottom: Back + Next/Finish -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onbBtnBack"
            style="@style/Widget.KotaTask.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onb_back"
            android:visibility="invisible"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onbBtnNext"
            style="@style/Widget.KotaTask.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:text="@string/onb_next"/>
    </LinearLayout>

</LinearLayout>
