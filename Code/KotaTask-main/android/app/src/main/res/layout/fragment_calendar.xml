<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_canvas">

    <!-- ═══ Calendar card ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/border_subtle"
        app:cardBackgroundColor="@color/bg_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- ── Month navigation ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageButton
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_iconbutton"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary"
                    android:contentDescription="Предыдущий месяц"/>

                <TextView
                    android:id="@+id/tvMonthYear"
                    style="@style/Kt.Text.H3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="17sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:contentDescription="@string/cal_today"/>

                <ImageButton
                    android:id="@+id/btnNextMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_iconbutton"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:scaleX="-1"
                    app:tint="@color/text_primary"
                    android:contentDescription="Следующий месяц"/>

            </LinearLayout>

            <!-- ── Day-of-week header ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/Kt.Text.Micro"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Пн" android:gravity="center" android:paddingBottom="8dp"/>
                <TextView style="@style/Kt.Text.Micro"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Вт" android:gravity="center" android:paddingBottom="8dp"/>
                <TextView style="@style/Kt.Text.Micro"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Ср" android:gravity="center" android:paddingBottom="8dp"/>
                <TextView style="@style/Kt.Text.Micro"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Чт" android:gravity="center" android:paddingBottom="8dp"/>
                <TextView style="@style/Kt.Text.Micro"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Пт" android:gravity="center" android:paddingBottom="8dp"/>
                <TextView style="@style/Kt.Text.Micro"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Сб" android:gravity="center" android:paddingBottom="8dp"
                    android:textColor="@color/text_secondary"/>
                <TextView style="@style/Kt.Text.Micro"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Вс" android:gravity="center" android:paddingBottom="8dp"
                    android:textColor="@color/error"/>

            </LinearLayout>

            <!-- ── Month grid ── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMonthGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ Selected date header ═══ -->
    <TextView
        android:id="@+id/tvCalSelectedDate"
        style="@style/Kt.Text.Overline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:text="@string/cal_select_hint"/>

    <!-- ═══ Task list for selected date ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"/>

</LinearLayout>
