# Шаблон. Скопируйте в keystore.properties и заполните пароли.
#   cp keystore.properties.example keystore.properties
# keystore.properties в .gitignore и в репозиторий не попадает.

# Путь к хранилищу ключей относительно папки app/
# PKCS12: пароль хранилища и пароль ключа совпадают.
RELEASE_STORE_FILE=kotatask-upload.p12
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=kotatask
RELEASE_KEY_PASSWORD=
